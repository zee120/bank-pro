{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "bank-pro: configure",
            "type": "process",
            "command": "cmake",
            "args": ["-S", ".", "-B", "build"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "bank-pro: build",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "bank-pro: configure",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc", "$msCompile"]
        },
        {
            "label": "bank-pro: run",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "build", "--config", "Debug", "--target", "run"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "bank-pro: build",
            "presentation": { "reveal": "always", "focus": true, "panel": "dedicated" },
            "problemMatcher": []
        }
    ]
}
